generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Runtime do app: endpoint com pooler (PgBouncer em transaction mode).
  url      = env("DATABASE_URL")
  // Migrations: endpoint direto, mesmo host sem o sufixo `-pooler`. O Prisma
  // Migrate usa advisory locks, que são de sessão e não sobrevivem ao
  // transaction pooling — por ali uma migração longa pode travar no meio.
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(CLIENTE)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  CLIENTE
  BARBEIRO
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  phone       String[]
  description String
  imageUrl    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  services    BarbershopService[]
}

model BarbershopService {
  id              String           @id @default(uuid())
  barbershopId    String
  name            String
  description     String
  imageUrl        String
  price           Decimal          @db.Decimal(10, 2)
  durationMinutes Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  barbershop      Barbershop       @relation(fields: [barbershopId], references: [id])
  // `bookings` é a relação antiga (1 serviço por agendamento) e existe só
  // durante a transição para `bookingServices`. Sai na migração seguinte.
  bookings        Booking[]
  bookingServices BookingService[]
}

model Booking {
  id         String            @id @default(uuid())
  userId     String?
  guestName  String?
  guestPhone String?
  date       DateTime
  status     BookingStatus     @default(CONFIRMADO)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User?             @relation(fields: [userId], references: [id])

  // Duração total do agendamento, congelada no momento da reserva. É a soma
  // das durações dos serviços em `services`, mas guardada aqui de propósito:
  // editar um serviço não pode reescrever a agenda de quem já reservou, e a
  // checagem de conflito precisa do intervalo sem agregar a tabela de junção.
  durationMinutes Int

  services BookingService[]

  // Campos da relação antiga (um serviço por agendamento). Continuam aqui
  // porque esta migração é aditiva: os dados são copiados para
  // `BookingService` e só a migração seguinte remove a coluna.
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])

  // Unicidade de `date` é garantida por um índice único PARCIAL criado via SQL
  // cru na migração `booking_partial_unique_by_date` (WHERE status <>
  // 'CANCELADO'), de forma que horários cancelados fiquem livres para novo
  // agendamento. Prisma não expressa índice parcial no schema declarativo, por
  // isso ele não aparece como @@unique aqui.
  //
  // A unicidade é por horário, não por (serviço, horário): é um barbeiro só,
  // então um Corte e uma Barba às 10:00 seriam dois clientes ao mesmo tempo.
  @@index([serviceId, date])
}

/// Serviços de um agendamento. Sem coluna de ordem: a lista é um conjunto, o
/// que o cliente marcou, e a exibição ordena pelo que fizer sentido na tela.
/// A chave composta já garante que o mesmo serviço não entre duas vezes.
model BookingService {
  bookingId String
  serviceId String
  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   BarbershopService @relation(fields: [serviceId], references: [id])

  @@id([bookingId, serviceId])
  @@index([serviceId])
}

enum BookingStatus {
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())
}
